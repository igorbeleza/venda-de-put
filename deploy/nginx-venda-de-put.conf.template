server {
    listen 80;
    server_name SERVER_NAME;
    # Site público (ADR 0004) — sem auth_basic. O login de administrador
    # é da própria app (aba Config, feriados, raspar agora), não do nginx.

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
