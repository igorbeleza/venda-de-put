[Unit]
Description=Dashboard venda de PUT
After=network.target

[Service]
Type=simple
User=venda-de-put
Group=venda-de-put
WorkingDirectory=/opt/venda-de-put
Environment=VENDA_DE_PUT_DATA=/opt/venda-de-put/data
# VENDA_DE_PUT_ADMIN_PASSWORD e VENDA_DE_PUT_SECRET_KEY (ADR 0004) vêm de
# /opt/venda-de-put/.env — o app carrega sozinho (load_dotenv), sem precisar
# de EnvironmentFile aqui. Ver deploy/RUNBOOK.md.
ExecStart=/opt/venda-de-put/.venv/bin/python -m venda_de_put serve --host 127.0.0.1 --port 8765
Restart=on-failure

[Install]
WantedBy=multi-user.target
