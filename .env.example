# Copie para .env (na raiz do projeto/WorkingDirectory) e preencha.
# .env nunca é versionado (.gitignore) — carregado por venda_de_put.paths.load_dotenv,
# sem sobrescrever variáveis já exportadas no ambiente. Ver docs/adr/0004-login-admin-unico.md.

# Senha do administrador único. Sem ela, /api/login sempre recusa (401).
VENDA_DE_PUT_ADMIN_PASSWORD=

# Assina o cookie de sessão do admin. Gere com: openssl rand -hex 32
# Sem essa chave fixa, a sessão cai a cada restart do processo.
VENDA_DE_PUT_SECRET_KEY=
